# MongoDB Configuration
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=resume_search
MONGODB_COLLECTION_NAME=resumes
MONGODB_VECTOR_INDEX=resume_vector_index
MONGODB_BM25_INDEX=BM25_Index

# Mistral API (Embeddings)
MISTRAL_API_KEY=s3IIrrzlGqf37RHssAsx8zdMjP8BA2t1
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_EMBED_DIMENSIONS=1024

# Groq API (LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Feature Toggles
ENABLE_SUMMARIZATION=true
RERANK_TOP_K=8
MAX_QUERY_LENGTH=2000
MAX_BATCH_SIZE=100
MAX_CANDIDATES_TO_RERANK=10

# Batch Upload Configuration
BATCH_UPLOAD_FOLDER=./Resumes
BATCH_SIZE=100
BATCH_WORKERS=10
BATCH_RETRY_ATTEMPTS=1
BATCH_RETRY_DELAY_MS=1000
BATCH_UPLOAD_QUEUE_ENABLED=false
BATCH_UPLOAD_QUEUE_WORKERS=2
BATCH_UPLOAD_SCHEDULE_ENABLED=false
BATCH_UPLOAD_SCHEDULE_INTERVAL_MS=3600000


# Summarization
SUMMARIZATION_STYLE=short
SUMMARIZATION_MAX_TOKENS=300

# Timeouts (milliseconds)
EMBEDDING_API_TIMEOUT=30000
LLM_API_TIMEOUT=60000
DATABASE_TIMEOUT=15000

# LLM Parser Toggle
USE_LLM_PARSER=true
